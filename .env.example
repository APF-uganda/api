SECRET_KEY="your-secret-key-here"
DEBUG=True
DB_NAME=apf_portal
DB_USER=postgres
DB_PASSWORD="your-password-here"
DB_HOST=localhost
DB_PORT=5432
DB_SSL_MODE=disable  # Use 'disable' for local PostgreSQL, 'require' for Neon/production

# EmailJS Configuration
EMAILJS_SERVICE_ID=your-emailjs-service-id
EMAILJS_TEMPLATE_ID_OTP=your-otp-template-id
EMAILJS_TEMPLATE_ID_PASSWORD_RESET=your-password-reset-template-id
EMAILJS_PUBLIC_KEY=your-emailjs-public-key

# Redis Configuration
REDIS_URL=redis://127.0.0.1:6379/1

